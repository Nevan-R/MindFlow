{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Server",
            "type": "shell",
            "command": "node",
            "args": ["server.js"],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "."
                }
            }
        },
        {
            "label": "Open MindMap",
            "type": "shell",
            "command": "start",
            "args": ["mindmap.html"],
            "windows": {
                "command": "start",
                "args": ["mindmap.html"]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
