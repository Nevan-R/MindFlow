{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch MindMap",
            "url": "http://localhost:5500/mindmap.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "Start Server"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch MindMap (File)",
            "file": "${workspaceFolder}/mindmap.html"
        }
    ]
}
